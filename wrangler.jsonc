// Cloudflare deploy settings. Cloudflare builds the site with `npm run build`
// and serves the files in /out.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wealthmack",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
